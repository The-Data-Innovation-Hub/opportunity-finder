{
  "name": "opportunity-finder-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "trial": "node Worker/trial.js",
    "test": "node --test \"Tests/*.test.js\"",
    "test:db": "node --test --test-concurrency=1 \"Tests/Db/*.test.js\"",
    "migrate": "node --env-file=.env Database/Migrate.js",
    "seed": "node --env-file=.env Database/Seeds/approvedModels.js",
    "dev:free-period": "node --env-file=.env.example Database/Seeds/devFreePeriod.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@azure/communication-email": "^1.1.0",
    "@azure/identity": "^4.14.0",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.34.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "stripe": "22.6.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
