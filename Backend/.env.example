# Opportunity Finder backend configuration. Names and safe examples only:
# copy to .env (git-ignored) for local development. In Azure these come from
# the Container App's environment and Key Vault references (Infra/main.bicep).

# Database. The API and jobs read OPPORTUNITY_FINDER_DATABASE_URL; in Azure
# each runs with its own least-privilege role (Infra/database-roles.sql).
OPPORTUNITY_FINDER_DATABASE_URL=postgresql:///opportunity_finder_dev
# OPPORTUNITY_FINDER_RUNTIME_DATABASE_URL=   # optional, API only
# OPPORTUNITY_FINDER_WORKER_DATABASE_URL=    # optional, jobs only

# Public address of the app (sign-in links and report emails point here).
APP_URL=http://localhost:5173
# Comma-separated origins allowed to send state-changing requests (default APP_URL).
# ALLOWED_ORIGINS=http://localhost:5173
PORT=3001
# Number of proxy hops in front of the API (1 on Azure Container Apps).
# TRUST_PROXY=1
# Built frontend to serve from the API (set in the container image).
# FRONTEND_DIR=../dist

# Azure services. Unset locally: dev stand-ins are used instead (in-memory
# key store, Output/dev-blobs, mail printed or kept, never sent). With
# NODE_ENV=production all three are required.
# NODE_ENV=production
# KEY_VAULT_URL=https://kv-oppfinder-keys-xxxx.vault.azure.net/
# BLOB_ACCOUNT_URL=https://stoppfinderxxxx.blob.core.windows.net/
# BLOB_CONTAINER=reports
# ACS_EMAIL_ENDPOINT=https://acs-oppfinder-xxxxxx.uk.communication.azure.com
# MAIL_SENDER=no-reply@thedatainnovationhub.com
# AZURE_CLIENT_ID=   # the user-assigned managed identity's client id
LOCAL_BLOB_DIR=Output/dev-blobs
# Print sign-in links and other mail to the console (development only).
DEV_PRINT_MAIL=1

# Worker
# Brave Search API key (programme-paid, DEC-008). Keep it in .env or Key Vault, never here.
BRAVE_SEARCH_API_KEY=
SCRAPER_URL=http://localhost:8080
# Resource group whose hosting cost the admin card shows.
# AZURE_COST_SCOPE=/subscriptions/<id>/resourceGroups/<rg>

# Tests: the server that test databases are created on (local only).
# OPPORTUNITY_FINDER_TEST_ADMIN_URL=postgresql:///postgres
